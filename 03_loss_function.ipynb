      "source": [
        "predicted = [0.1, 0.2, 0.8]\n",
        "\n",
        "expected = [0.0, 0.0, 1.0]\n",
        "\n",
        "def loss_function(predcited, expected):\n",
        "  loss = 0.0\n",
        "\n",
        "  for p, e in zip(predicted, expected):\n",
        "    loss += (p-e) ** 2\n",
        "\n",
        "  return loss\n",
        "\n",
        "loss = loss_function(predicted, expected)\n",
        "\n",
        "print(\"Loss:\", loss)"
      ]
